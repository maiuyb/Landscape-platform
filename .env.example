# Copy to .env in the project root. Never put a real key in this example.
DASHSCOPE_API_KEY=
AI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_MODEL=qwen3.8-flash
# auto: demo without a key, cloud with a key. live: missing key is an error.
AI_MODE=auto
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=2200
AI_MAX_CONCURRENT=2
AI_REQUESTS_PER_MINUTE=10
# When deployed behind an HTTPS reverse proxy, set the exact public origin.
# PUBLIC_ORIGIN=https://your-domain.example

# 163 Mail SMTP configuration (Shanghai server friendly, SSL port 465)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=qjx2967886936@163.com
# Note: Use 163 Mail SMTP Authorization Code (客户端授权码), not login password.
SMTP_PASS=
# Admin email to receive sponsorship notifications and one-click 24h redemption code approval links
SPONSOR_ADMIN_EMAIL=qjx2967886936@163.com
# Secret salt for signing one-click sponsor approval links
SPONSOR_SIGN_SECRET=

