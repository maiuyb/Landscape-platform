[Unit]
Description=Check GitHub main and update Landscape atomically
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=landscape
Group=landscape
ExecStart=/usr/bin/python3 /usr/local/libexec/landscape-update.py
# Optional administrator-only proxy for this updater, never application secrets.
EnvironmentFile=-/etc/landscape/update.env
TimeoutStartSec=45min
UMask=0027
# This service uses one narrowly scoped sudoers rule to restart the app.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/landscape /var/lib/landscape
